# ─────────────────────────────────────────────────────────────────────────────
# PLOT — copy to .env. Defaults run the FULL slice with mocks and ZERO real keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core infra (match docker-compose.yml) ---
DATABASE_URL="postgresql://plot:plot@localhost:5432/plot?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Service URLs (how the pieces find each other) ---
API_BASE_URL="http://localhost:3000"
WEB_BASE_URL="http://localhost:3001"
AGENT_BASE_URL="http://localhost:8000"
API_PORT=3000
WEB_PORT=3001
AGENT_PORT=8000

# --- Inngest (durable workflow). Dev mode needs no real keys. ---
INNGEST_DEV=1
INNGEST_BASE_URL="http://localhost:8288"
INNGEST_EVENT_KEY="local-dev"
INNGEST_SIGNING_KEY="local-dev"

# --- Auth: AuthProvider selection. "mock" => OTP 000000, canned Apple identity. ---
AUTH_PROVIDER="mock"          # mock | stytch
JWT_SECRET="dev-only-change-me"
JWT_TTL_SECONDS=2592000
# STYTCH_PROJECT_ID=""        # TODO: REAL CREDENTIAL
# STYTCH_SECRET=""            # TODO: REAL CREDENTIAL

# --- Agent LLM. With no key, agent uses the deterministic fallback classifier. ---
# ANTHROPIC_API_KEY=""        # TODO: REAL CREDENTIAL (enables Claude tool-use)
ANTHROPIC_MODEL="claude-opus-4-8"

# --- Comms (non-user SMS bridge). "mock" logs the SMS + serves the link via /web. ---
COMMS_PROVIDER="mock"         # mock | twilio
# TWILIO_ACCOUNT_SID=""       # TODO: REAL CREDENTIAL
# TWILIO_AUTH_TOKEN=""        # TODO: REAL CREDENTIAL
# TWILIO_FROM_NUMBER=""       # TODO: REAL CREDENTIAL

# --- Payments (split/escrow). "mock" fully models the money state machine. ---
PAYMENT_PROVIDER="mock"       # mock | stripe
# STRIPE_SECRET_KEY=""        # TODO: REAL CREDENTIAL
# STRIPE_CONNECT_CLIENT_ID="" # TODO: REAL CREDENTIAL

# --- Push notifications. "mock" logs token + payload. ---
PUSH_PROVIDER="mock"          # mock | apns
# APNS_KEY_ID=""              # TODO: REAL CREDENTIAL
# APNS_TEAM_ID=""             # TODO: REAL CREDENTIAL
# APNS_BUNDLE_ID="com.plot.app"

# --- Integrations: which connectors to use. Mocks are deterministic + canned. ---
CALENDAR_PROVIDER="mock"      # mock | google
PLACES_PROVIDER="mock"        # mock | google
BOOKING_PROVIDER="mock"       # mock (books + degrades) | stub (always degrade) | opentable (TODO)

# --- Media storage. "disk" writes under ./.media ---
MEDIA_STORE="disk"            # disk | s3
MEDIA_DISK_DIR="./.media"
# S3_BUCKET=""                # TODO: REAL CREDENTIAL (R2/S3)
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Slice tuning ---
PLOT_SOFT_DEADLINE_SECONDS=45 # compressed so auto-lock is observable in a demo
PLOT_LINK_SIGNING_SECRET="dev-link-secret-change-me"
PLOT_DEFAULT_SPEND_CAP_CENTS=5000
PLOT_DEMO_NOW_ISO="2026-06-05T18:00:00.000Z"  # Friday — demo availability/anchor (seed matches)
