# ─────────────────────────────────────────────────────────────────────────────
# PLOT — copy to .env. Defaults run the FULL slice with mocks and ZERO real keys.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core infra (match docker-compose.yml) ---
DATABASE_URL="postgresql://plot:plot@localhost:5432/plot?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Service URLs (how the pieces find each other) ---
API_BASE_URL="http://localhost:3000"
WEB_BASE_URL="http://localhost:3001"
AGENT_BASE_URL="http://localhost:8000"
API_PORT=3000
WEB_PORT=3001
AGENT_PORT=8000

# --- Inngest (durable workflow). Dev mode needs no real keys. ---
INNGEST_DEV=1
INNGEST_BASE_URL="http://localhost:8288"
INNGEST_EVENT_KEY="local-dev"
INNGEST_SIGNING_KEY="local-dev"

# --- Auth. "otp" = REAL phone-OTP (random code, Redis-hashed, 5-min TTL, single-use, rate-limited),
#     delivered over the real comms channel (SMTP). "mock" = legacy fixed 000000. ---
AUTH_PROVIDER="otp"          # otp (real) | stytch | mock
DEV_OTP_HINT="1"             # dev only: surface the random code as devHint so the sim/demo can log in (set 0 to hide)
JWT_SECRET="dev-only-change-me"
JWT_TTL_SECONDS=2592000
# STYTCH_PROJECT_ID=""        # TODO: REAL CREDENTIAL (hosted auth + Apple login)
# STYTCH_SECRET=""            # TODO: REAL CREDENTIAL

# --- Agent LLM. With no key, agent uses the deterministic fallback classifier. ---
# ANTHROPIC_API_KEY=""        # TODO: REAL CREDENTIAL (enables Claude tool-use)
ANTHROPIC_MODEL="claude-opus-4-8"

# --- Comms. "smtp" = REAL email over SMTP to Mailpit (docker); "twilio" = real cellular SMS. ---
COMMS_PROVIDER="smtp"         # smtp (real, Mailpit) | twilio | mock
SMTP_HOST="localhost"
SMTP_PORT=1025                # Mailpit SMTP; inbox UI at http://localhost:8025
SMTP_FROM="Plot <plot@plot.local>"
# TWILIO_ACCOUNT_SID=""       # TODO: REAL CREDENTIAL (cellular SMS)
# TWILIO_AUTH_TOKEN=""        # TODO: REAL CREDENTIAL
# TWILIO_FROM_NUMBER=""       # TODO: REAL CREDENTIAL

# --- Payments (split/escrow). "stripe" = REAL Stripe SDK → stripe-mock (docker), no paid key. ---
PAYMENT_PROVIDER="stripe"     # stripe (real SDK → stripe-mock) | mock
STRIPE_API_BASE="http://localhost:12111"  # stripe-mock; clear this + set a live key to hit Stripe
# STRIPE_SECRET_KEY=""        # TODO: REAL CREDENTIAL (live sk_live_…); dev uses a built-in sk_test_…
# STRIPE_CONNECT_CLIENT_ID="" # TODO: REAL CREDENTIAL

# --- Push notifications. "mock" logs token + payload. ---
PUSH_PROVIDER="mock"          # mock | apns
# APNS_KEY_ID=""              # TODO: REAL CREDENTIAL
# APNS_TEAM_ID=""             # TODO: REAL CREDENTIAL
# APNS_BUNDLE_ID="com.plot.app"

# --- Integrations: which connectors to use. Mocks are deterministic + canned. ---
CALENDAR_PROVIDER="mock"      # mock | google
PLACES_PROVIDER="db"           # db (real catalog query) | google (TODO) | mock
BOOKING_PROVIDER="mock"       # mock (books + degrades) | stub (always degrade) | opentable (TODO)

# --- MCP servers: real capabilities the AGENT pulls in as gated loop tools (Calendar/Maps/Resy…). ---
# JSON array; each server's tools are registered through the trust gate — read tools go to the loop,
# `mutating` tools (book/reserve/pay) become irreversible → human-approval. Empty = no MCP tools.
# Fill in the credentials (Google Maps key, OAuth, etc.) and uncomment to go live:
# PLOT_MCP_SERVERS='[
#   {"name":"calendar","transport":"stdio","command":"npx","args":["-y","@cocal/google-calendar-mcp"],"env":{"GOOGLE_OAUTH_CREDENTIALS":"/path/creds.json"},"mutating":["create-event","update-event","delete-event"]},
#   {"name":"maps","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-google-maps"],"env":{"GOOGLE_MAPS_API_KEY":"…"},"mutating":[]},
#   {"name":"resy","transport":"stdio","command":"npx","args":["-y","restaurant-mcp"],"env":{"RESY_API_KEY":"…"},"mutating":["book_reservation"]}
# ]'

# --- Media storage. "disk" writes under ./.media ---
MEDIA_STORE="disk"            # disk | s3
MEDIA_DISK_DIR="./.media"
# S3_BUCKET=""                # TODO: REAL CREDENTIAL (R2/S3)
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Slice tuning ---
PLOT_SOFT_DEADLINE_SECONDS=45 # compressed so auto-lock is observable in a demo
PLOT_TIEBREAK_SECONDS=120 # one short extension before Plot asks the group to pick
PLOT_LINK_SIGNING_SECRET="dev-link-secret-change-me"
PLOT_DEFAULT_SPEND_CAP_CENTS=5000
PLOT_DEMO_NOW_ISO="2026-06-05T18:00:00.000Z"  # Friday — demo availability/anchor (seed matches)
